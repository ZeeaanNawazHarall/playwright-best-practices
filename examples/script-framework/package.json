{
  "name": "framework-script-based",
  "version": "1.0.0",
  "description": "Playwright script-based framework for SauceDemo with the same scenarios as the original POM version.",
  "scripts": {
    "test": "playwright test",
    "test:chromium": "playwright test --project=chromium",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "report": "npx playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@types/dotenv": "^8.2.3",
    "@types/node": "^22.19.17",
    "@typescript-eslint/eslint-plugin": "^8.59.1",
    "@typescript-eslint/parser": "^8.59.1",
    "allure-commandline": "^2.38.1",
    "allure-playwright": "^3.7.1",
    "eslint": "^10.3.0",
    "eslint-plugin-complexity": "^1.0.2"
  }
}
